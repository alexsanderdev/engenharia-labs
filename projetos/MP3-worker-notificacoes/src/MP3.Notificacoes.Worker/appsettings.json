{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  "Urls": "http://localhost:5680",
  "ConnectionStrings": {
    "ServiceBus": "",
    "Inbox": ""
  },
  "ServiceBus": {
    "Fila": "notificacoes-pedidos",
    "MaxConcorrencia": 4,
    "Prefetch": 0
  },
  "Notificacoes": {
    "CanalPadrao": "console",
    "Retry": {
      "MaxTentativas": 5,
      "AtrasoBase": "00:00:05",
      "AtrasoMaximo": "00:05:00",
      "Jitter": 0.2
    }
  },
  "Smtp": {
    "Modo": "PastaDeSaida",
    "PastaDeSaida": "emails-enviados",
    "Host": "localhost",
    "Porta": 25,
    "Remetente": "nao-responda@orderflow.local"
  }
}
